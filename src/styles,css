body {
  margin:0;
  font-family: 'Poppins', sans-serif;
  background:#f4f6fa;
}

/* Layout */
.layout{
  display:flex;
}

/* Sidebar */
.sidebar{
  width:250px;
  background:linear-gradient(180deg,#6a11cb,#2575fc);
  height:100vh;
  color:white;
  padding:20px;
}

.sidebar h2{
  margin-bottom:30px;
}

.sidebar li{
  list-style:none;
  padding:12px;
  border-radius:8px;
  cursor:pointer;
}

.sidebar li:hover{
  background:rgba(255,255,255,0.2);
}

/* Main */
.main{
  flex:1;
  padding:20px;
}

.navbar{
  background:white;
  padding:15px;
  border-radius:12px;
  display:flex;
  justify-content:space-between;
  margin-bottom:20px;
  box-shadow:0 3px 10px rgba(0,0,0,0.1);
}

/* Cards */
.card{
  background:white;
  padding:20px;
  border-radius:15px;
  box-shadow:0 5px 15px rgba(0,0,0,0.1);
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:20px;
}

/* Quiz Attempt */
.quiz-container{
  display:flex;
}

.quiz-main{
  flex:3;
  padding:20px;
  background:white;
  border-radius:15px;
}

.quiz-side{
  flex:1;
  margin-left:20px;
  background:white;
  border-radius:15px;
  padding:20px;
}

.option{
  padding:12px;
  border-radius:8px;
  margin:10px 0;
  background:#f1f3f6;
  cursor:pointer;
}

.option.selected{
  background:#6a11cb;
  color:white;
}

.progress-bar{
  height:8px;
  background:#ddd;
  border-radius:5px;
  margin-bottom:15px;
}

.progress{
  height:8px;
  background:#6a11cb;
  border-radius:5px;
}
